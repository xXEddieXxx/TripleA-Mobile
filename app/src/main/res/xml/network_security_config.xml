<?xml version="1.0" encoding="utf-8"?>
<!-- The app only talks HTTPS: the map list from prod.triplea-game.org, map downloads from GitHub; cleartext is refused. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
