<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: cleartext http:// and ws:// is allowed so the app can talk to a local game
     server (the emulator reaches the host at 10.0.2.2). Release keeps the main config: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
