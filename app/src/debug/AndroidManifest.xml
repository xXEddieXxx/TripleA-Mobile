<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: permissions for a local game server; cleartext comes from res/xml/network_security_config.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 17 blocks private addresses (10.0.2.2, a LAN server) without it; asked on the Online screen -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- the online games' turn notifications (TurnCheckWorker); asked on the Online screen -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <!-- push (Firebase Cloud Messaging); without app/google-services.json Firebase stays uninitialised and this never runs -->
        <service
            android:name=".push.TripleAMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- no token before the user plays online: PushPlatform switches it on when it registers -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="battle" />
    </application>

</manifest>
